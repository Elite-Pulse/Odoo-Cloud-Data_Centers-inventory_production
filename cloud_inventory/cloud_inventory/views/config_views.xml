    <record id="view_cluster_tree" model="ir.ui.view">
        <field name="name">cloud.inv.cluster.tree</field>
        <field name="model">cloud.inv.cluster</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/></list>
