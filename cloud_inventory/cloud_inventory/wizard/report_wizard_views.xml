<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_wizard_form" model="ir.ui.view">
        <field name="name">cloud.inv.report.wizard.form</field>
        <field name="model">cloud.inv.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Cloud Inventory Reporting">
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="not asset_ids">
                        <div>Export of the manual selection. The filters are ignored.</div>
                        <field name="asset_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                    </div>

                    <group string="Report Options">
                        <field name="report_type" widget="radio"/>
                    </group>

                    <group string="Audit Search" invisible="asset_ids">
                        <group>
                            <field name="search_terms" placeholder="One term per line: service tag, name, model, license key, rack, date..."/>
                        </group>
                        <group>
                            <field name="exact_match"/>
                            <field name="match_mode" widget="radio"/>
                        </group>
                    </group>

                    <group string="Location" invisible="asset_ids">
                        <group>
                            <field name="datacenter_ids" widget="many2many_tags"/>
                            <field name="hall_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="room_ids" widget="many2many_tags"/>
                            <field name="rack_ids" widget="many2many_tags"/>
                            <field name="lane"/>
                            <field name="warehouse_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Product" invisible="asset_ids">
                        <group>
                            <field name="nature"/>
                            <field name="product_type_ids" widget="many2many_tags"/>
                            <field name="brand_ids" widget="many2many_tags"/>
                            <field name="model_ids" widget="many2many_tags"/>
                            <field name="cluster_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="cpu_ids" widget="many2many_tags"/>
                            <field name="ram_ids" widget="many2many_tags"/>
                            <field name="storage_ids" widget="many2many_tags"/>
                            <field name="nic_ids" widget="many2many_tags"/>
                            <field name="hba_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="site_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Status and Dates" invisible="asset_ids">
                        <group>
                            <field name="state"/>
                            <field name="reason"/>
                            <field name="responsible_ids" widget="many2many_tags"/>
                            <field name="include_history"/>
                        </group>
                        <group>
                            <field name="date_in_from"/>
                            <field name="date_in_to"/>
                            <field name="date_out_from"/>
                            <field name="date_out_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Generate PDF" type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" string="Generate Excel" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button name="action_reset" string="Reset" type="object" class="btn-secondary" invisible="asset_ids"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_wizard" model="ir.actions.act_window">
        <field name="name">Export Excel / PDF</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_report_audit" model="ir.actions.act_window">
        <field name="name">Audit Search</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'audit'}</field>
    </record>

    <record id="action_report_in_warehouse" model="ir.actions.act_window">
        <field name="name">Report: In Warehouse</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_state': 'in_warehouse'}</field>
    </record>
    <record id="action_report_in_service" model="ir.actions.act_window">
        <field name="name">Report: In Service</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_state': 'in_service'}</field>
    </record>
    <record id="action_report_in_transit" model="ir.actions.act_window">
        <field name="name">Report: In Transit</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_state': 'in_transit'}</field>
    </record>
    <record id="action_report_decommissioned" model="ir.actions.act_window">
        <field name="name">Report: Decommissioned</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_state': 'decommissioned', 'default_include_history': True}</field>
    </record>
    <record id="action_report_digital" model="ir.actions.act_window">
        <field name="name">Report: Licenses and Keys</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_nature': 'digital'}</field>
    </record>
    <record id="action_report_logical" model="ir.actions.act_window">
        <field name="name">Report: Logical Items</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_nature': 'logical'}</field>
    </record>
    <record id="action_report_bdc" model="ir.actions.act_window">
        <field name="name">Report: Benguerir (BDC)</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context" eval="{'default_datacenter_ids': [(6, 0, [ref('dc_bdc')])]}"/>
    </record>
    <record id="action_report_cdc" model="ir.actions.act_window">
        <field name="name">Report: Casa (CDC)</field>
        <field name="res_model">cloud.inv.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context" eval="{'default_datacenter_ids': [(6, 0, [ref('dc_cdc')])]}"/>
    </record>
</odoo>
