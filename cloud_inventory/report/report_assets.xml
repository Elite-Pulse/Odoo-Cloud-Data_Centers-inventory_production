<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_cloud_inv_landscape" model="report.paperformat">
        <field name="name">Cloud Inventory A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_assets" model="ir.actions.report">
        <field name="name">Cloud Inventory (PDF)</field>
        <field name="model">cloud.inv.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cloud_inventory.report_assets</field>
        <field name="report_file">cloud_inventory.report_assets</field>
        <field name="paperformat_id" ref="paperformat_cloud_inv_landscape"/>
        <field name="print_report_name">'cloud_inventory'</field>
        <field name="groups_id" eval="[(4, ref('cloud_inventory.group_cloud_inv_manager'))]"/>
    </record>

    <!-- Every label comes from the Python side (translated with the user's language) -->
    <template id="report_assets">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc.get_report_data()"/>
                <t t-set="lb" t-value="data['labels']"/>
                <div class="page" style="font-size:9px">
                    <div style="border-bottom:3px solid #714B67;padding-bottom:6px;margin-bottom:8px">
                        <h2 style="margin:0;color:#714B67" t-out="data['title']"/>
                        <div style="color:#555" t-out="data['filters']"/>
                        <div style="color:#555" t-out="data['meta']"/>
                    </div>

                    <!-- Audit: which searched terms were found -->
                    <t t-if="data['coverage']">
                        <h4 style="color:#714B67" t-out="lb['coverage']"/>
                        <table style="width:100%;border-collapse:collapse;margin-bottom:12px">
                            <thead>
                                <tr style="background:#714B67;color:#fff">
                                    <th style="padding:3px" t-out="lb['term']"/>
                                    <th t-out="lb['result']"/>
                                    <th t-out="lb['matches']"/>
                                    <th t-out="lb['references']"/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['coverage']" t-as="cov">
                                    <tr t-attf-style="background:#{'#fff' if cov['count'] else '#F8D7DA'}">
                                        <td style="padding:3px" t-out="cov['term']"/>
                                        <td t-out="lb['found'] if cov['count'] else lb['not_found']"/>
                                        <td t-out="cov['count']"/>
                                        <td t-out="cov['refs']"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Detailed / audit table -->
                    <t t-if="data['report_type'] != 'summary'">
                        <t t-if="data['pdf_rows']">
                            <table style="width:100%;border-collapse:collapse">
                                <thead>
                                    <tr style="background:#714B67;color:#fff">
                                        <t t-foreach="data['pdf_headers']" t-as="h">
                                            <th style="padding:3px" t-out="h"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data['pdf_rows']" t-as="row">
                                        <tr t-attf-style="background:#{'#F4EFF3' if row_index % 2 else '#fff'};#{'color:#999' if row['out'] else ''}">
                                            <t t-foreach="row['cells']" t-as="cell">
                                                <td style="padding:3px;border-bottom:1px solid #e5e5e5" t-out="cell"/>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p t-out="lb['no_result']"/>
                        </t>
                    </t>

                    <!-- Summary tables -->
                    <t t-if="data['report_type'] == 'summary'">
                        <t t-foreach="data['summary']" t-as="block">
                            <table style="width:45%;border-collapse:collapse;margin-bottom:12px;display:inline-table;margin-right:2%;vertical-align:top">
                                <thead>
                                    <tr style="background:#714B67;color:#fff">
                                        <th style="padding:3px" t-out="block[0]"/>
                                        <th style="text-align:right" t-out="lb['count']"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="block[1]" t-as="line">
                                        <tr>
                                            <td style="padding:3px;border-bottom:1px solid #e5e5e5" t-out="line[0]"/>
                                            <td style="text-align:right;border-bottom:1px solid #e5e5e5" t-out="line[1]"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
