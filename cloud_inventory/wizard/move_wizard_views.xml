<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_wizard_form" model="ir.ui.view">
        <field name="name">cloud.inv.move.wizard.form</field>
        <field name="model">cloud.inv.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Move equipment">
                <sheet>
                    <field name="asset_ids" widget="many2many_tags" readonly="1"/>
                    <group>
                        <group>
                            <field name="move_type" widget="radio"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="request_ref"/>
                            <field name="replacement_id" invisible="move_type not in ('return', 'decommission', 'deploy')"/>
                        </group>
                    </group>
                    <group string="Destination: Warehouse" invisible="move_type not in ('receive', 'return', 'decommission')">
                        <group>
                            <field name="datacenter_id" options="{'no_create': True}"/>
                            <field name="warehouse_id" required="move_type in ('receive', 'return')" options="{'no_create': True}"/>
                        </group>
                        <group><field name="shelf"/></group>
                    </group>
                    <group string="Destination: Rack" invisible="move_type not in ('deploy', 'relocate')">
                        <group>
                            <field name="datacenter_id" options="{'no_create': True}"/>
                            <field name="hall_id" options="{'no_create': True}"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="rack_id" required="move_type in ('deploy', 'relocate')" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="ru_start"/>
                            <field name="ru_end"/>
                        </group>
                    </group>
                    <group string="Destination: Other Site" invisible="move_type != 'transfer'">
                        <field name="destination_id" required="move_type == 'transfer'" options="{'no_create': True}"/>
                    </group>
                    <field name="comment" placeholder="Comment (why is it moved, who asked for it...)"/>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
