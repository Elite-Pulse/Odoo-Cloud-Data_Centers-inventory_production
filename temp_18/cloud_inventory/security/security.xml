<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cloud_inv" model="ir.module.category">
        <field name="name">Cloud Inventory</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_cloud_inv_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_cloud_inv"/>
    </record>

    <record id="group_cloud_inv_manager" model="res.groups">
        <field name="name">Manager (Settings and Export)</field>
        <field name="category_id" ref="module_category_cloud_inv"/>
        <field name="implied_ids" eval="[(4, ref('group_cloud_inv_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Every Administrator automatically gets Cloud Inventory manager rights (Settings and Export) -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('cloud_inventory.group_cloud_inv_manager'))]"/>
    </record>
</odoo>
